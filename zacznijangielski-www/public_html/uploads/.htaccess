# W tym katalogu są tylko zdjęcia wgrane z panelu: nic nie może się tu wykonać.
<FilesMatch "\.(?i:php\d*|phtml|phar|pl|py|cgi|sh|shtml|html?|svg)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
Options -ExecCGI -Indexes
