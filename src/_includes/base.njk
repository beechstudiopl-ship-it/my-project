<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title if title else site.name }}</title>
  <meta name="description" content="{{ metaDescription if metaDescription else site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Wersje językowe (na razie tylko PL; sekcja /en/ dojdzie w etapie 3) #}
  <link rel="alternate" hreflang="pl-PL" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title if title else site.name }}">
  <meta property="og:description" content="{{ metaDescription if metaDescription else site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="pl_PL">

  <link rel="stylesheet" href="/css/style.css">

  {# --- Dane strukturalne JSON-LD (przeniesione z wtyczki claude-seo-ai) --- #}
  {% include "schema/localbusiness.njk" %}
  {% if breadcrumbs %}{% include "schema/breadcrumb.njk" %}{% endif %}
  {% if serviceSchema %}{% include "schema/service.njk" %}{% endif %}
  {% if faq %}{% include "schema/faq.njk" %}{% endif %}
</head>
<body>
  {% include "header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  {% include "whatsapp.njk" %}
</body>
</html>
