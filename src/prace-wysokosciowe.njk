---
layout: base.njk
pagination:
  data: cities
  size: 1
  alias: city
  addAllPagesToCollections: true
permalink: "/prace-wysokosciowe-{{ city.slug }}/"
eleventyComputed:
  title: "{{ city.title }}"
  metaDescription: "{{ city.metaDescription }}"
---
{# Schemat Service (areaServed = miasto) + breadcrumbs, budowane per-miasto. #}
{% set serviceSchema = { name: "Prace i usługi wysokościowe — " + city.name, description: "Alpinizm przemysłowy i dostęp linowy w standardzie IRATA w " + city.locative + ": przeglądy, mycie, montaże i naprawy na wysokości.", areaServed: city.name } %}
{% include "schema/service.njk" %}
{% set breadcrumbs = [ { name: "Start", url: "/" }, { name: city.name, url: "/prace-wysokosciowe-" + city.slug + "/" } ] %}
{% include "schema/breadcrumb.njk" %}

<nav class="crumbs container" aria-label="Ścieżka">
  <a href="/">Start</a> <span>/</span> <span>{{ city.name }}</span>
</nav>

<section class="section">
  <div class="container">
    <p class="eyebrow">{{ site.region }} · standard IRATA</p>
    <h1>{{ city.h1 }}</h1>
    <p class="hero-lead">{{ city.lead }}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="{{ site.phone | telHref }}">📞 {{ site.phone }}</a>
      <a class="btn btn-outline" href="https://wa.me/{{ site.whatsapp | waNumber }}" rel="noopener">💬 WhatsApp</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2>Usługi wysokościowe w {{ city.locative }}</h2>
    <div class="cards">
      {%- for s in services %}
      <a class="card" href="/uslugi/{{ s.slug }}/">
        <h3>{{ s.name }}</h3>
        <p>{{ s.short }}</p>
        <span class="card-more">Zobacz →</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Alpinizm przemysłowy na terenie {{ city.locative }}</h2>
    <p>{{ city.localNote }}</p>
    <p>Realizujemy prace w dzielnicach takich jak:</p>
    <ul class="chips">
      {%- for d in city.districts %}
      <li>{{ d }}</li>
      {%- endfor %}
    </ul>
    <p>
      Szukasz frazy „prace wysokościowe {{ city.name }}", „usługi wysokościowe {{ city.name }}"
      lub „usługi alpinistyczne {{ city.name }}"? Trafiłeś w dobre miejsce — zajmujemy się
      dokładnie tym, w standardzie IRATA.
    </p>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <h2>Wycena dla {{ city.locative }}</h2>
    <p>Opisz zakres i dołącz zdjęcia — odpowiadamy najczęściej tego samego dnia.</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="{{ site.phone | telHref }}">📞 {{ site.phone }}</a>
      <a class="btn btn-outline" href="https://wa.me/{{ site.whatsapp | waNumber }}" rel="noopener">💬 WhatsApp</a>
      <a class="btn btn-ghost" href="/kontakt/">Formularz kontaktu</a>
    </div>
  </div>
</section>
